# Build stage
FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /app

# 第一步：只复制 pom.xml，下载依赖（依赖变化少，可以缓存）
COPY pom.xml ./
RUN mvn dependency:go-offline -B

# 第二步：复制源码并打包（源码变了才重跑）
COPY src ./src
RUN mvn clean package -DskipTests -o   # -o 表示离线模式

# Run stage
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
COPY --from=build /app/target/*.jar app.jar

EXPOSE 8080
# A 股业务时间钉死东八区：Java 自带 tzdb，不依赖镜像里的 tzdata
# （与 StocktrackerApplication.main 的 TimeZone.setDefault 双保险）
ENTRYPOINT ["java", "-Duser.timezone=Asia/Shanghai", "-jar", "app.jar"]